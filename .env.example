# 登录微博后，从浏览器请求头中复制完整 Cookie。未填写时只尝试匿名抓取。
WEIBO_COOKIE=

# 配置后优先使用抖音登录态，失败时自动匿名兜底；与微博 Cookie 不通用。
DOUYIN_COOKIE=

# Telegram BotFather 创建的 Bot Token。
TELEGRAM_BOT_TOKEN=

# 频道用户名（例如 @channel_name）或 -100 开头的频道 ID。
TELEGRAM_CHANNEL_ID=

# 管理员与 Bot 私聊的数字 ID，用于授权 /refresh_cookie 命令。
# 即使 notifications_use_channel=true，也必须配置此项才能从 Telegram 手动扫码。
TELEGRAM_ALERT_CHAT_ID=
